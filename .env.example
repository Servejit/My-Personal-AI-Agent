# Optional local GGUF model for offline text generation
LOCAL_MODEL_PATH=
LOCAL_N_CTX=4096
LOCAL_N_THREADS=2

# External AI providers are disabled unless explicitly enabled.
# Set to true only if you consent to send prompts/lyrics to hosted services.
ALLOW_EXTERNAL_AI=false
# GEMINI_API_KEY=  # only needed if ALLOW_EXTERNAL_AI=true
